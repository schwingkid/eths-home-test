# Security headers for static Cloudflare Pages responses.
# Pages Functions (/api/*) set their own headers in functions/api/_middleware.js.
# Deliberately no full Content-Security-Policy yet: the site uses inline JS,
# Google Fonts, YouTube embeds, and media — a strict CSP needs its own tested pass.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
